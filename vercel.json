{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "http://102.37.1.46:8083/api/v1/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "http://102.37.1.46:8083/media/:path*"
    },
    {
      "source": "/((?!api/|media/).*)",
      "destination": "/index.html"
    }
  ]
}
